node_modules/
build/
dist/
dist-server/
coverage/
.DS_Store
*.log
.env
.env.*
!.env.example

# SQLite database files. The app uses exactly one — data/database.sqlite — and
# these patterns exist so no other can ever reach the repository, including one
# written by a stray script or a hand-edited path.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
data/

# Merge and editor leftovers. Absent from a clean tree, but a single conflicted
# merge leaves .orig and .rej files that git helpfully offers to commit — and
# `git add -A` would take them. Cheap to prevent.
*.orig
*.rej
*~

# TypeScript incremental build info. This project is `noEmit` with no
# `incremental`, so it is never produced today; ignored anyway because turning
# `incremental` on is a one-line change that would otherwise start committing
# machine-local build caches.

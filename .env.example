# ==============================================================================
# GAMETRACK ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# IGDB API Credentials (OPTIONAL — required for Discover and metadata lookup)
# The server boots and the whole library works without these. They are needed
# only for the Discover page, IGDB-backed metadata/posters, and
# `npm run reset-metadata`, each of which fails with a clear message if unset.
# Get them from the Twitch Developer Portal (dev.twitch.tv/console/apps) —
# IGDB is authenticated through Twitch's client-credentials flow.
# ------------------------------------------------------------------------------
IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here

# ------------------------------------------------------------------------------
# Steam Web API Key (OPTIONAL)
# Used to sync your Steam library and track playtime.
# ------------------------------------------------------------------------------
# STEAM_WEB_API_KEY=your_steam_api_key_here

# ------------------------------------------------------------------------------
# Security Configuration (OPTIONAL / REQUIRED FOR REMOTE ACCESS)
# API_TOKEN: When set, every /api request must include `Authorization: Bearer <token>`.
# REQUIRED whenever HOST is not a loopback address (the server refuses to start otherwise).
# Recommended even on loopback when the machine is shared.
# The web client sends it automatically when built with VITE_API_TOKEN set, or
# when a `gametrack_api_token` localStorage entry exists in the browser.
# NOTE: VITE_API_TOKEN is baked into the client bundle at build time. Anyone who
# can load the page can read it, so treat it as a same-origin guard, not a secret.
# Unset API_TOKEN when running `npm test` — the test suite deletes it from its
# own environment, but this is the reminder of why that line exists.
# ------------------------------------------------------------------------------
# API_TOKEN=change-me
# VITE_API_TOKEN=change-me

# ------------------------------------------------------------------------------
# Storage Configuration (OPTIONAL)
# Data directory override (defaults to ./data). Useful for container volumes.
# ------------------------------------------------------------------------------
# GAMETRACK_DATA_DIR=/path/to/data

# ------------------------------------------------------------------------------
# Server Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# PORT=3001
# HOST=127.0.0.1
# NODE_ENV=development

# ------------------------------------------------------------------------------
# CORS Configuration (OPTIONAL)
# Additional browser origins allowed for state-changing requests (comma separated).
# The loopback address is always allowed; add your real domain when deploying
# behind a hostname, e.g. https://track.example.com.
# ------------------------------------------------------------------------------
# ALLOWED_ORIGINS=https://track.example.com
